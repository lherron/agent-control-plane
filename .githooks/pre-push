#!/bin/sh
set -eu

repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" || {
  echo "ACP pre-push hook error: not inside a Git worktree." >&2
  exit 2
}

# Walk up for the binary instead of assuming this repo's node_modules. A
# standalone install resolves at the first step, exactly as before. Under the
# praesidium dev workspace agent-control-plane installs as one workspace with
# agent-spaces and hrc-runtime, and bun hoists binaries to the shared root,
# leaving no repo-local node_modules/.bin — this guard would then refuse every
# push even though lefthook is present one directory up.
lefthook_bin=""
search_dir="$repo_root"
while :; do
  if [ -x "$search_dir/node_modules/.bin/lefthook" ]; then
    lefthook_bin="$search_dir/node_modules/.bin/lefthook"
    break
  fi
  parent="$(dirname "$search_dir")"
  [ "$parent" = "$search_dir" ] && break
  search_dir="$parent"
done

if [ -z "$lefthook_bin" ]; then
  echo "ACP pre-push hook error: lefthook is not installed in any node_modules/.bin at or above $repo_root." >&2
  echo "Run 'just install' from $repo_root (or the workspace root), then retry the push." >&2
  exit 127
fi

# Both lefthook and the git reporter consume the ref transitions on stdin.
refs_file="$(mktemp "${TMPDIR:-/tmp}/acp-pre-push.XXXXXX")"
trap 'rm -f "$refs_file"' EXIT
trap 'exit 1' HUP INT TERM
cat > "$refs_file"

# Keep the existing gate authoritative; report only after it passes.
"$lefthook_bin" run pre-push --no-auto-install "$@" < "$refs_file" || exit "$?"

# Best-effort: a timeline outage must never block a push.
if command -v wrkp >/dev/null 2>&1; then
  wrkp git push "$1" "$2" < "$refs_file" >/dev/null 2>&1 || true
fi
exit 0
