<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>com.praesidium.AgentHost</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>/Users/lherron</string>
		<key>LANG</key>
		<string>en_US.UTF-8</string>
		<key>PATH</key>
		<string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>Label</key>
	<string>com.praesidium.log-rotation</string>
	<key>ProcessType</key>
	<string>Background</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/lherron/.local/bin/praesidium-launch</string>
		<string>/bin/bash</string>
		<string>/Users/lherron/praesidium/agent-control-plane/scripts/rotate-praesidium-logs.sh</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/Users/lherron/praesidium/var/logs/praesidium-log-rotation.err.log</string>
	<key>StandardOutPath</key>
	<string>/Users/lherron/praesidium/var/logs/praesidium-log-rotation.log</string>
	<key>StartInterval</key>
	<integer>900</integer>
	<key>WorkingDirectory</key>
	<string>/Users/lherron/praesidium/agent-control-plane</string>
</dict>
</plist>
