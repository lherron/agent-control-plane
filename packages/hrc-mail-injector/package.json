{
  "name": "hrc-mail-injector",
  "version": "0.1.0",
  "description": "Standalone owner of HRC collaboration-mail delivery",
  "type": "module",
  "bin": {
    "hrc-mail-injector": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && bun build ./src/index.ts ./src/cli.ts --outdir ./dist --target bun --external agent-scope --external hrc-core --external hrc-injector-core --external hrc-sdk --external hrc-store-sqlite --external spaces-harness-broker-protocol",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "agent-scope": "0.1.1-dev.20261003114510",
    "hrc-core": "0.5.13-dev.20261003130456",
    "hrc-injector-core": "0.1.0-dev.20260920014352",
    "hrc-sdk": "0.5.13-dev.20261003130456",
    "hrc-store-sqlite": "0.5.13-dev.20261003130456",
    "spaces-harness-broker-protocol": "0.1.1-dev.20261003114510"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "^5.8.3"
  }
}
