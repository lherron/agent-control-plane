{
  "name": "hrc-viewer",
  "version": "0.1.0",
  "private": true,
  "description": "Per-user Ghostty presentation sidecar for HRC runtimes",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "hrc-viewer": "./bin/hrc-viewer.js"
  },
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "bun test --timeout 10000"
  },
  "dependencies": {
    "agent-scope": "0.1.1-dev.20260918162214",
    "hrc-sdk": "0.1.0-dev.20260919232026"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "^5.8.3"
  }
}
