  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@wrkq/client": "latest",
    "hrc-core": "0.5.13-dev.20261004092853",
    "hrc-sdk": "0.5.13-dev.20261004092853"
  },
  "devDependencies": {
